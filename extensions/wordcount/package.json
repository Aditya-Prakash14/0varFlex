{
	"name": "wordcount",
	"publisher": "0varflex",
	"version": "1.0.0",
	"engines": {
		"0varflex": "^1.0.0"
	},
	"main": "./out/extension.js",
	"activationEvents": [
		"onLanguage:plaintext",
		"onCommand:wordcount.toggleWhitespace"
	],
	"contributes": {
		"commands": [
			{
				"command": "wordcount.toggleWhitespace",
				"title": "Toggle Whitespace Counting",
				"category": "Word Count"
			}
		],
		"configuration": {
			"title": "Word Count",
			"properties": {
				"wordcount.includeWhitespace": {
					"type": "boolean",
					"default": false,
					"description": "Count whitespace-split tokens instead of lines with content."
				}
			}
		},
		"languages": [
			{
				"id": "wordcount-log",
				"aliases": ["Word Count Log"],
				"extensions": ["wordlog"]
			}
		]
	}
}
